From 4680dae585241b4b4eb2ba108ac157929dee6ad6 Mon Sep 17 00:00:00 2001
From: Jonathan Albrecht <jonathan.albrecht@ibm.com>
Date: Thu, 15 Jan 2026 16:08:46 -0500
Subject: [PATCH 1/2] Fix an endian problem in upb that caused protoc plugins
 to crash on big endian platforms

---
 third_party/protobuf/upb/wire/decode.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/third_party/protobuf/upb/wire/decode.c b/third_party/protobuf/upb/wire/decode.c
index 6da57877b5..b9ff2a0755 100644
--- a/third_party/protobuf/upb/wire/decode.c
+++ b/third_party/protobuf/upb/wire/decode.c
@@ -1079,6 +1079,7 @@ const char* _upb_Decoder_DecodeWireValue(upb_Decoder* d, const char* ptr,
           *op = kUpb_DecodeOp_UnknownField;
           return ptr;
         }
+        _upb_Decoder_MungeInt32(val);
       } else {
         _upb_Decoder_Munge(field, val);
       }
-- 
2.54.0


From 6cba883ae375e93a9f7a30e5f0ff531d30e64b61 Mon Sep 17 00:00:00 2001
From: Jonathan Albrecht <jonathan.albrecht@ibm.com>
Date: Tue, 3 Feb 2026 15:07:37 -0500
Subject: [PATCH 2/2] Fix an endian problem when memcpying in
 _upb_Decoder_DecodeEnumPacked

---
 third_party/protobuf/upb/wire/decode.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/third_party/protobuf/upb/wire/decode.c b/third_party/protobuf/upb/wire/decode.c
index b9ff2a0755..3f53a61d42 100644
--- a/third_party/protobuf/upb/wire/decode.c
+++ b/third_party/protobuf/upb/wire/decode.c
@@ -488,6 +488,7 @@ static const char* _upb_Decoder_DecodeEnumPacked(
       _upb_Decoder_AddEnumValueToUnknown(d, msg, field, &elem);
       continue;
     }
+    _upb_Decoder_MungeInt32(&elem);
     if (_upb_Decoder_Reserve(d, arr, 1)) {
       out = UPB_PTR_AT(upb_Array_MutableDataPtr(arr),
                        arr->UPB_PRIVATE(size) * 4, void);
-- 
2.54.0

